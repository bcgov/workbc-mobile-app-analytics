{
  "name": "workbc-mobile-app-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "WorkBC mobile app analytics API",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
